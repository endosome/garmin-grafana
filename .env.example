PGDATABASE=garmin
PGUSER=garmin
PGPASSWORD=replace-with-a-long-random-password
GRAFANA_PASSWORD=replace-with-another-long-random-password
GRAFANA_DB_PASSWORD=replace-with-a-reader-password
GRAFANA_PORT=3000
# Dashboard file shown after login: Garmin-Health-Overview.json, Garmin-Grafana-Dashboard.json,
# Garmin-Strength-Training-Dashboard.json or Garmin-Ski-Season.json
# GRAFANA_HOME_DASHBOARD=Garmin-Health-Overview.json
ACCOUNT_ID=default
USER_TIMEZONE=UTC
# Optional: use an interactive login to keep Garmin credentials out of .env.
# GARMINCONNECT_EMAIL=
# GARMINCONNECT_BASE64_PASSWORD=
